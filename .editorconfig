root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.lua]
max_line_length = 120

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
max_line_length = 120
# Two trailing spaces are a line break in Markdown
trim_trailing_whitespace = false

# Source engine text formats (model compile script, materials) use tabs
[*.{qc,qci,vmt}]
indent_style = tab
indent_size = 4

# Blender export: CRLF as written by the exporter, never reformat
[*.smd]
end_of_line = crlf
insert_final_newline = unset
trim_trailing_whitespace = false
indent_style = unset
indent_size = unset
